  "tableData": "{{\n  Normal.data\n    .filter(row =>\n  row.status === \"onProgress\" ||\n  (row.createdat >= '2026-04-01' && row.status === \"onProgress\" && row.approvedby !== \"Rejected\")\n)\n    .sort((a, b) => {\n      const getPriority = (item) => {\n        if (!item.approvedby) return 1; // Action\n        if (item.approvedby === \"Approved\" && item.status === \"Pending\") return 2;\n        if (item.approvedby === \"Approved\" && item.status === \"onProgress\") return 3;\n        if (item.approvedby === \"Approved\" && item.status === \"Completed\") return 4;\n        if (item.approvedby === \"Rejected\") return 5;\n        return 6;\n      };\n\n      const priorityA = getPriority(a);\n      const priorityB = getPriority(b);\n\n      if (priorityA !== priorityB) {\n        return priorityA - priorityB;\n      }\n\n      // Same priority group\n      if (priorityA === 4) {\n        // For Completed \u2192 most recent first\n        return new Date(b.createdat) - new Date(a.createdat);\n      }\n\n      // For all other groups \u2192 oldest first\n      return new Date(a.createdat) - new Date(b.createdat);\n    })\n}}\n",
