  "renderMode": "CANVAS",
  "responsiveBehavior": "fill",
  "rightColumn": 64,
  "searchKey": "",
  "showInlineEditingOptionDropdown": true,
  "tableData": "{{\n  Normal.data\n    .filter(row => row.status === \"Completed\"&row.work_end_time>='2026-04-01'& (row.category==='MIS'|| row.category==null) & row.requested_time !=null)\n    .sort((a, b) => {\n      // Priority only needed if you plan to differentiate within \"Completed\"\n      const getPriority = (item) => {\n        if (item.approvedby==='Action') return 1;\n        if (item.approvedby === \"Approved\") return 2;\n        if (item.approvedby === \"Rejected\") return 3;\n        return 4;\n      };\n\n      const priorityA = getPriority(a);\n      const priorityB = getPriority(b);\n\n      if (priorityA !== priorityB) {\n        return priorityA - priorityB;\n      }\n\n      // Within same priority, show most recent first\n      return new Date(b.closedat) - new Date(a.closedat);\n    })\n}}\n",
  "textSize": "0.875rem",
